[Unit]
Description=retype file conversion daemon
Documentation=https://github.com/LapilliWorks/retype
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env "@PREFIX@/bin/retype" daemon
# Let the daemon drain in-flight conversions before an update or removal.
KillMode=mixed
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
