[Unit]
Description=retype file conversion daemon
Documentation=https://github.com/LapilliWorks/retype
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env "@PREFIX@/bin/retype" daemon
# Let in-flight conversions drain before an update or removal.
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
